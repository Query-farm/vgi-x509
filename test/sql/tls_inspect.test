riO1AiEA1Cd3nEmbffFOBMjt3TmYKYZRo4DskxRqX4I41HUb274=
-----END CERTIFICATE-----'))
SELECT t.subject, i.name AS inventory_name
FROM x509.main.tls_inspect('{VGI_X509_TEST_ADDR}', insecure := true) AS t
LEFT JOIN certs AS i ON x509.main.cert_fingerprint(i.pem) = t.fingerprint ORDER BY t.seq;
----
CN=mock.tls.local,O=VGI X509 Test	NULL

# timeout_ms and server_name options are accepted.
query I
SELECT count(*) FROM x509.tls_inspect(
  '{VGI_X509_TEST_ADDR}',
  insecure := true,
  timeout_ms := 5000,
  server_name := 'mock.tls.local');
----
1

# NULL host:port -> no rows (not an error).
query I
SELECT count(*) FROM x509.tls_inspect(NULL, insecure := true);
----
0

# Unreachable endpoint surfaces a clean error (short timeout keeps it fast).
statement error
SELECT * FROM x509.tls_inspect('127.0.0.1:1', insecure := true, timeout_ms := 2000);
----
