# name: test/sql/tls_inspect.test
# description: tls_inspect against the local mock TLS server (start/stop driven by the Makefile)
# group: [vgi_x509]

require-env VGI_X509_WORKER

require-env VGI_X509_TEST_ADDR

statement ok
LOAD vgi;

statement ok
ATTACH 'x509' AS x509 (TYPE vgi, LOCATION '{VGI_X509_WORKER}');

# The mock TLS server presents a single self-signed cert with CN=mock.tls.local.
# insecure := true so we inspect (not trust) the self-signed chain.

# Exactly one cert in the presented chain.
query I
SELECT count(*) FROM x509.tls_inspect('{VGI_X509_TEST_ADDR}', insecure := true);
----
1

# The presented leaf has the expected subject.
query T
SELECT subject FROM x509.tls_inspect('{VGI_X509_TEST_ADDR}', insecure := true) WHERE seq = 0;
----
CN=mock.tls.local,O=VGI X509 Test

# Self-signed: issuer equals subject.
query T
SELECT issuer FROM x509.tls_inspect('{VGI_X509_TEST_ADDR}', insecure := true) WHERE seq = 0;
----
CN=mock.tls.local,O=VGI X509 Test

# Fingerprint is a 64-char lowercase hex SHA-256.
query T
SELECT regexp_full_match(fingerprint, '^[0-9a-f]{64}$')
FROM x509.tls_inspect('{VGI_X509_TEST_ADDR}', insecure := true) WHERE seq = 0;
----
true

# Leaf is not a CA.
query T
SELECT is_ca FROM x509.tls_inspect('{VGI_X509_TEST_ADDR}', insecure := true) WHERE seq = 0;
----
false

# Validity columns are real TIMESTAMPs and ordered.
query T
SELECT not_before < not_after
FROM x509.tls_inspect('{VGI_X509_TEST_ADDR}', insecure := true) WHERE seq = 0;
----
true

# Composed inventory match (ComposedLiveInventoryExample): the mock server's
# certificate is in neither committed fixture, so inventory_name is NULL.
# tls_pin.test covers the matching case.
query TT
WITH certs(name, pem) AS (VALUES ('test', '-----BEGIN CERTIFICATE-----
MIIB3DCCAYGgAwIBAgIEOt5osTAKBggqhkjOPQQDAjA7MRkwFwYDVQQKExBWR0kg
WDUwOSBGaXh0dXJlMR4wHAYDVQQDExV0ZXN0LnZnaS14NTA5LmV4YW1wbGUwHhcN
MjUwMTAxMDAwMDAwWhcNMzUwMTAxMDAwMDAwWjA7MRkwFwYDVQQKExBWR0kgWDUw
OSBGaXh0dXJlMR4wHAYDVQQDExV0ZXN0LnZnaS14NTA5LmV4YW1wbGUwWTATBgcq
hkjOPQIBBggqhkjOPQMBBwNCAAS7Zbq+Bz73Y0wKrZZkw4owgz7qyAtXYUrNUkac
Ot2h1WpF/Y+ODgRoeo0+ixbqPxA8+Lm9DTpksjsxTMRni/Owo3MwcTAOBgNVHQ8B
Af8EBAMCAoQwEwYDVR0lBAwwCgYIKwYBBQUHAwEwDAYDVR0TAQH/BAIwADA8BgNV
HREENTAzghV0ZXN0LnZnaS14NTA5LmV4YW1wbGWCFGFsdC52Z2kteDUwOS5leGFt
cGxlhwR/AAABMAoGCCqGSM49BAMCA0kAMEYCIQCGCty4v7uWVHE/HhanzxE2kzBo
KBiJ1j25vqPbFP4x7AIhAPdzfBNzgiIxriWsiBH1HBtoOCRsMJ6WN+j7zxyn9Np0
-----END CERTIFICATE-----'), ('legacy', '-----BEGIN CERTIFICATE-----
MIIB0jCCAXigAwIBAgICA+kwCQYHKoZIzj0EATA5MRkwFwYDVQQKExBWR0kgWDUw
OSBGaXh0dXJlMRwwGgYDVQQDExNWR0kgWDUwOSBGaXh0dXJlIENBMB4XDTE1MDEw
MTAwMDAwMFoXDTE2MDEwMTAwMDAwMFowPTEZMBcGA1UEChMQVkdJIFg1MDkgRml4
dHVyZTEgMB4GA1UEAxMXbGVnYWN5LnZnaS14NTA5LmV4YW1wbGUwgZ8wDQYJKoZI
hvcNAQEBBQADgY0AMIGJAoGBAKnXtIZR7d7y/tykoXIu2UFuu6pOM3wTOgeA9REt
a9h+tGfssuxWZ7c8ILquhCxda+A92qlCepAbgh7sfDCoV7X0ST5gzF+YuzXRxgxh
