9e35a0b16a0912d01fc75093fd8ab5500f0a425e6b91110c0054f66bb7df5b16

# ---- second fixture: a legacy, CA-issued, RSA-1024 / ECDSA-SHA1 certificate ----
# (legacyPEM in internal/x509worker/meta.go: expired 2016-01-01, serial 1001.)

statement ok
CREATE TABLE certs AS SELECT 'test' AS name, pem FROM fixture;

statement ok
INSERT INTO certs VALUES ('legacy', '-----BEGIN CERTIFICATE-----
MIIB0jCCAXigAwIBAgICA+kwCQYHKoZIzj0EATA5MRkwFwYDVQQKExBWR0kgWDUw
OSBGaXh0dXJlMRwwGgYDVQQDExNWR0kgWDUwOSBGaXh0dXJlIENBMB4XDTE1MDEw
